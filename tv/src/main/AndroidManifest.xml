<!-- Dedicated HOME replacement: no duplicate entry in the TV applications list. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools" tools:ignore="MissingLeanbackLauncher">
<uses-permission android:name="android.permission.INTERNET" />
<uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
<permission android:name="belowevolve.tvhome.permission.READ_THEME" android:protectionLevel="normal" />
<uses-permission android:name="belowevolve.tvhome.permission.READ_THEME" />
<permission android:name="belowevolve.tvhome.permission.INTERNAL_CONTROL" android:protectionLevel="signature" />
<uses-permission android:name="belowevolve.tvhome.permission.INTERNAL_CONTROL" />
<uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
<uses-permission android:name="android.permission.READ_TV_LISTINGS" />
<uses-permission android:name="com.android.providers.tv.permission.READ_EPG_DATA" />
<uses-permission android:name="org.amnezia.awg.permission.CONTROL_TUNNELS" />
<uses-feature android:name="android.software.leanback" android:required="true" />
<uses-feature android:name="android.hardware.touchscreen" android:required="false" />
<queries><intent><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.LEANBACK_LAUNCHER" /></intent><package android:name="mov.film" /><package android:name="org.amnezia.awg" /><package android:name="com.cxinventor.file.explorer" /><package android:name="io.gh.reisxd.tizentube.cobalt" /><intent><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.LAUNCHER" /></intent></queries>
<application android:label="Air Home" android:banner="@drawable/banner" android:icon="@mipmap/ic_air_home" android:theme="@android:style/Theme.Material.NoActionBar" android:allowBackup="false" android:usesCleartextTraffic="true" android:hardwareAccelerated="true">
<provider android:name=".ThemeProvider" android:authorities="belowevolve.tvhome.theme" android:exported="true" android:permission="belowevolve.tvhome.permission.READ_THEME" />
<activity android:name=".HomeActivity" android:taskAffinity="belowevolve.tvhome.home" android:exported="true" android:launchMode="singleTask" android:excludeFromRecents="true">
<intent-filter><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.HOME" /><category android:name="android.intent.category.DEFAULT" /></intent-filter>
</activity>
<activity android:name=".HdmiActivity" android:taskAffinity="belowevolve.tvhome.hdmi" android:exported="false" android:launchMode="singleTask" android:excludeFromRecents="true" />
<activity android:name=".RemoteLaunchActivity" android:exported="true" android:noHistory="true"
    android:excludeFromRecents="true" android:theme="@android:style/Theme.NoDisplay">
    <intent-filter>
        <action android:name="android.intent.action.VIEW" />
        <category android:name="android.intent.category.DEFAULT" />
        <category android:name="android.intent.category.BROWSABLE" />
        <data android:scheme="airhome" android:host="remote" android:path="/film" />
        <data android:path="/youtube" />
        <data android:path="/pc" />
        <data android:path="/volume" />
        <data android:path="/seek" />
        <data android:path="/wake" />
    </intent-filter>
</activity>
<activity android:name=".SettingsActivity" android:taskAffinity="belowevolve.tvhome.settings" android:exported="true" android:launchMode="singleTask" android:excludeFromRecents="true" />
<activity android:name=".ThemeActivity" android:exported="false" />
<service android:name=".MediaAccessService" android:label="Air Home · управление медиа"
    android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE" android:exported="true">
    <intent-filter><action android:name="android.service.notification.NotificationListenerService" /></intent-filter>
    <meta-data android:name="android.service.notification.default_filter_types" android:value="ongoing" />
    <meta-data android:name="android.service.notification.disabled_filter_types" android:value="conversations|alerting|silent" />
</service>
<service android:name=".ColorKeyService" android:process=":keys" android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE" android:exported="true" android:label="Air Home · цветные кнопки">
<intent-filter><action android:name="android.accessibilityservice.AccessibilityService" /></intent-filter>
<meta-data android:name="android.accessibilityservice" android:resource="@xml/color_keys" />
</service>
</application></manifest>
